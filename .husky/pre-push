# ============================================================
# Pre-Push Hook：推送前校验
# ============================================================
# 校验内容：
#   1. 任务 ID 校验 — commit 中的 #数字ID 是否有效
#   2. Commit 格式校验 — 是否符合 [模块] #任务ID 描述
# 任何一项不通过都会阻止 push，并给出修复方案
# ============================================================

BRANCH=$(git rev-parse --abbrev-ref HEAD)

# 尝试获取远程分支最新 commit（不存在 = 首次推送）
REMOTE_HEAD=""
git rev-parse "origin/$BRANCH" 2>/dev/null && REMOTE_HEAD=$(git rev-parse "origin/$BRANCH")

# ============================================================
# Step 1: 任务 ID 校验
# ============================================================
node .husky/verify-task.js || {
  echo ""
  echo "==================== 修复方案 ===================="
  echo ""

  if [ -z "$REMOTE_HEAD" ]; then
    RANGE="HEAD"
  else
    RANGE="${REMOTE_HEAD}..HEAD"
  fi

  # 检查是不是因为缺少任务 ID
  HAS_ID=$(git log "$RANGE" --format="%s" | grep -c '#[0-9]' 2>/dev/null || echo 0)

  if [ "$HAS_ID" -eq 0 ]; then
    echo " 原因：commit 中缺少任务 ID（#数字 格式）"
    echo ""
    echo " 复制以下命令修复："
    echo "   git commit --amend -m \"[模块] #12345 你的描述\""
    echo ""
    echo " 如果要修改多个 commit："
    echo "   git rebase -i origin/$BRANCH"
    echo "   将需要改的 commit 标记为 reword，保存后逐个修改"
  else
    echo " 原因：任务 ID 不存在或已关闭"
    echo ""
    echo " 请确认任务 ID 是否正确，然后重新 push："
    echo "   git push"
  fi

  echo ""
  echo " 可用的任务 ID（Demo）：12345, 67890, 10001, 10002, 10003"
  echo "========================================================="
  echo ""
  exit 1
}

# ============================================================
# Step 2: Commit 格式校验
# ============================================================
echo "📋 校验 commit 格式..."

if [ -n "$REMOTE_HEAD" ]; then
  FROM="--from origin/$BRANCH"
else
  FROM=""
fi

npx commitlint $FROM --to HEAD 2>/dev/null || {
  echo ""
  echo "==================== 修复方案 ===================="
  echo ""
  echo " 原因：commit message 格式不符合 [模块] #任务ID 描述"
  echo ""
  echo " 正确格式示例："
  echo "   [前端] #12345 修复首页样式问题"
  echo "   [后端] #67890 添加用户登录接口"
  echo "   [配置] #10001 更新 ESLint 规则"
  echo ""
  echo " 修复命令（最近 1 个 commit）："
  echo "   git commit --amend -m \"[模块] #任务ID 描述\""
  echo ""
  echo " 修复命令（多个 commit）："
  echo "   git rebase -i origin/$BRANCH"
  echo "   把有问题的 commit 标记为 reword → 保存 → 逐个修改"
  echo ""
  echo " 可用的模块前缀：前端 / 后端 / 全栈 / 配置 / 文档 / 依赖 / 测试 / 重构"
  echo "========================================================="
  echo ""
  exit 1
}

echo ""
echo "✅ 全部校验通过，允许推送"
